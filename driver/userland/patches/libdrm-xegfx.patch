diff --git a/xf86drm_xegfx.c b/xf86drm_xegfx.c
new file mode 100644
index 00000000..fe50051f
--- /dev/null
+++ b/xf86drm_xegfx.c
@@ -0,0 +1,671 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * XeGfx (Darwin): dma-buf and sync_file file descriptors in userspace. A kext cannot create file descriptors, so
+ * PRIME export, sync_file export and syncobj sync_file export cannot happen in the kernel. drmIoctl() answers them
+ * here instead, with stand-in descriptors: each is the read end of a pipe whose write end is closed, remembered
+ * with its inode so a recycled number is noticed. A dma-buf stands for (DRM file, GEM handle); a sync_file stands
+ * for a syncobj on that DRM file, filled and drained by the XeGfx ioctls 'N' 0x42/0x43 and SYNCOBJ_TRANSFER.
+ *
+ * Limits: a stand-in only works on the DRM file it came from; poll() on a sync_file stand-in always reports
+ * ready; opaque syncobj fds are snapshots, not shared syncobjs; SYNC_IOC_MERGE is not supported.
+ * <wtl> project: xegfx | author: watchthelight </wtl>
+ */
+#ifdef __APPLE__
+#include <errno.h>
+#include <sys/types.h>
+#include <dirent.h>
+#include <string.h>
+#include <stdio.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <IOKit/IOKitLib.h>
+
+#include "libdrm_macros.h"
+#include "xf86drm.h"
+#include "xf86drm_xegfx.h"
+
+/* include/uapi/linux/dma-buf.h */
+struct xg_dma_buf_sync_file {
+    uint32_t flags;
+    int32_t fd;
+};
+#define XG_DMA_BUF_SYNC_RW      3
+#define XG_DMA_BUF_IOCTL_EXPORT_SYNC_FILE _IOWR('b', 2, struct xg_dma_buf_sync_file)
+#define XG_DMA_BUF_IOCTL_IMPORT_SYNC_FILE _IOW('b', 3, struct xg_dma_buf_sync_file)
+
+/* the kext's gpu/xkpi/src/i915/xg_drm_sync.h */
+struct xg_drm_bo_fence {
+    uint32_t handle;
+    uint32_t flags;
+    uint32_t syncobj;
+    uint32_t pad;
+};
+#define XG_DRM_IOCTL_BO_EXPORT_FENCE _IOW('N', 0x42, struct xg_drm_bo_fence)
+#define XG_DRM_IOCTL_BO_IMPORT_FENCE _IOW('N', 0x43, struct xg_drm_bo_fence)
+
+/* XG_DRMNODE (E16): a DRM node instance XeGfxAccel opened for a process whose sandbox refuses /dev/dri */
+enum { XG_DMABUF = 1, XG_SYNCFILE, XG_SYNCOBJ, XG_DRMNODE };
+
+struct xg_efd {
+    int fd;
+    dev_t dev;
+    ino_t ino;
+    int kind;
+    int drm_fd;
+    uint32_t handle;    /* GEM handle for a dma-buf, instance minor for a DRM node, syncobj otherwise */
+    dev_t rdev;         /* a DRM node's: what fstat would have said */
+};
+
+static struct xg_efd *xg_tab;
+static int xg_n, xg_cap;
+/* recursive: drop() runs with it held and destroys syncobjs through raw_ioctl, whose remote_minor() looks the
+ * descriptor up again (K12's DRM-node stand-ins); a plain mutex deadlocked every process that dropped a stand-in */
+static pthread_mutex_t xg_lock = PTHREAD_RECURSIVE_MUTEX_INITIALIZER;
+
+/*
+ * WindowServer's sandbox allows a read-only open of /dev/dri nodes but no ioctl(2) on any device node. Such a
+ * descriptor's ioctls go to XeGfxAccel's 'XGDR' user client instead, named by the descriptor's instance minor;
+ * XeGfx only accepts them from the process that opened that instance.
+ */
+#define XG_FD_INST_FLAG 0x800000
+static io_connect_t xg_conn;
+static pthread_once_t xg_conn_once = PTHREAD_ONCE_INIT;
+
+static void conn_open(void)
+{
+    io_service_t svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NMXAccel"));
+
+    if (svc) {
+        if (IOServiceOpen(svc, mach_task_self(), 0x58474452u, &xg_conn) != KERN_SUCCESS)
+            xg_conn = 0;
+        IOObjectRelease(svc);
+    }
+}
+
+static int lookup(int fd, struct xg_efd *out);
+
+static int remote_minor(int fd)
+{
+    struct stat st;
+    struct xg_efd e;
+    int fl;
+
+    if (lookup(fd, &e) && e.kind == XG_DRMNODE)
+        return (int)e.handle;
+    fl = fcntl(fd, F_GETFL);
+
+    if (fl == -1 || (fl & O_ACCMODE) != O_RDONLY || fstat(fd, &st) != 0 || !S_ISCHR(st.st_mode))
+        return -1;
+    if ((st.st_rdev & XG_FD_INST_FLAG) == 0)
+        return -1;
+    return (int)(st.st_rdev & 0xffffff);
+}
+
+static int remote_ioctl(int minor, unsigned long request, void *arg)
+{
+    uint64_t in[3] = { (uint64_t)minor, (uint64_t)request, (uint64_t)(uintptr_t)arg }, out = 0;
+    uint32_t n = 1;
+
+    pthread_once(&xg_conn_once, conn_open);
+    if (!xg_conn) {
+        errno = ENOTTY;
+        return -1;
+    }
+    do {
+        if (IOConnectCallScalarMethod(xg_conn, 0, in, 3, &out, &n) != KERN_SUCCESS) {
+            errno = EIO;
+            return -1;
+        }
+    } while (out == EINTR || out == EAGAIN);
+    if (out != 0) {
+        errno = (int)out;
+        return -1;
+    }
+    return 0;
+}
+
+drm_public int drmXeGfxRawIoctl(int fd, unsigned long request, void *arg)
+{
+    int ret, minor = remote_minor(fd);
+
+    if (minor >= 0)
+        return remote_ioctl(minor, request, arg);
+    do {
+        ret = ioctl(fd, request, arg);
+    } while (ret == -1 && (errno == EINTR || errno == EAGAIN));
+    return ret;
+}
+
+/*
+ * E16: app sandboxes (Safari's WebContent and GPU processes, Calculator, App Store apps) refuse /dev/dri
+ * entirely: no open, no readdir, often no stat. They may open IOAccelerator user clients, and the XGDR client is one,
+ * so it lists the nodes (selector 4) and opens an instance for the caller (selector 2, closed by selector 3); the
+ * caller gets a stand-in descriptor whose ioctls go to selector 0 like WindowServer's. XEGFX_KOPEN=1 takes this path
+ * even outside a sandbox, to test it from Terminal.
+ */
+struct xg_node { int kind, id; dev_t udev; };
+static struct xg_node xg_nodes[16];
+static int xg_nnodes = -1;
+static pthread_mutex_t xg_node_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static int xg_call(uint32_t sel, const uint64_t *in, uint32_t nin, uint64_t *out, uint32_t nout)
+{
+    pthread_once(&xg_conn_once, conn_open);
+    if (!xg_conn)
+        return ENXIO;
+    if (IOConnectCallScalarMethod(xg_conn, sel, in, nin, out, &nout) != KERN_SUCCESS)
+        return ENXIO;
+    return 0;
+}
+
+static int kopen_forced(void)
+{
+    const char *v = getenv("XEGFX_KOPEN");
+
+    return v != NULL && v[0] == '1';
+}
+
+/* the kernel's /dev/dri, asked once per process (again while it is empty) */
+static int nodes(struct xg_node *out, int max)
+{
+    int n;
+
+    pthread_mutex_lock(&xg_node_lock);
+    if (xg_nnodes <= 0) {
+        int k = 0;
+
+        for (uint64_t idx = 0; idx < 64 && k < 16; idx++) {
+            uint64_t o[4] = { 0 };
+
+            if (xg_call(4, &idx, 1, o, 4) != 0 || o[3] != 0)
+                break;
+            if (o[0] > 1)
+                continue;
+            xg_nodes[k].kind = (int)o[0];
+            xg_nodes[k].id = (int)o[1];
+            xg_nodes[k].udev = (dev_t)o[2];
+            k++;
+        }
+        xg_nnodes = k;
+    }
+    n = xg_nnodes < max ? xg_nnodes : max;
+    for (int i = 0; i < n; i++)
+        out[i] = xg_nodes[i];
+    pthread_mutex_unlock(&xg_node_lock);
+    return n;
+}
+
+/* "/dev/dri/card0" or "/dev/dri/renderD128" -> its node; 0 when it is not a node the kernel has */
+static int node_of_path(const char *path, struct xg_node *nd)
+{
+    struct xg_node l[16];
+    const char *b;
+    int kind, id, n;
+    char tail;
+
+    if (strncmp(path, "/dev/dri/", 9) != 0)
+        return 0;
+    b = path + 9;
+    if (sscanf(b, "renderD%d%c", &id, &tail) == 1)
+        kind = 1;
+    else if (sscanf(b, "card%d%c", &id, &tail) == 1)
+        kind = 0;
+    else
+        return 0;
+    n = nodes(l, 16);
+    for (int i = 0; i < n; i++)
+        if (l[i].kind == kind && l[i].id == id) {
+            *nd = l[i];
+            return 1;
+        }
+    return 0;
+}
+
+static int new_efd(int kind, int drm_fd, uint32_t handle);
+static void set_rdev(int fd, dev_t rdev);
+
+static int kernel_open(const char *path)
+{
+    struct xg_node nd;
+    uint64_t in[2], out[2] = { 0 };
+    int fd, err;
+
+    if (!node_of_path(path, &nd)) {
+        errno = ENOENT;
+        return -1;
+    }
+    in[0] = (uint64_t)nd.kind;
+    in[1] = (uint64_t)nd.id;
+    if ((err = xg_call(2, in, 2, out, 2)) != 0 || (err = (int)out[1]) != 0) {
+        errno = err;
+        return -1;
+    }
+    if ((fd = new_efd(XG_DRMNODE, -1, (uint32_t)out[0])) < 0) {
+        uint64_t m = out[0], r = 0;
+
+        err = errno;
+        xg_call(3, &m, 1, &r, 1);
+        errno = err;
+        return -1;
+    }
+    /* the device number fstat on a real open would give: the node's major, this instance's minor */
+    set_rdev(fd, makedev(major(nd.udev), (uint32_t)out[0] & 0xffffff));
+    return fd;
+}
+
+/* open(2), falling back to read-only where a sandbox refuses write access (WindowServer), and to an instance the
+ * kernel opens where it refuses the node altogether (apps) */
+drm_public int drmXeGfxOpen(const char *path, int flags)
+{
+    int fd, saved;
+
+    if (kopen_forced() && (fd = kernel_open(path)) >= 0)
+        return fd;
+    fd = open(path, flags);
+    if (fd < 0 && (errno == EPERM || errno == EACCES) && (flags & O_ACCMODE) == O_RDWR)
+        fd = open(path, (flags & ~O_ACCMODE) | O_RDONLY);
+    if (fd < 0 && (errno == EPERM || errno == EACCES)) {
+        saved = errno;
+        if ((fd = kernel_open(path)) < 0 && errno == ENOENT)
+            errno = saved;
+    }
+    return fd;
+}
+
+#define raw_ioctl drmXeGfxRawIoctl
+
+static void syncobj_destroy(int drm_fd, uint32_t h)
+{
+    struct drm_syncobj_destroy d = { .handle = h };
+
+    raw_ioctl(drm_fd, DRM_IOCTL_SYNCOBJ_DESTROY, &d);
+}
+
+static int still_ours(const struct xg_efd *e)
+{
+    struct stat st;
+
+    return fstat(e->fd, &st) == 0 && S_ISFIFO(st.st_mode) && st.st_dev == e->dev && st.st_ino == e->ino;
+}
+
+/* with xg_lock held: forget entry i, and its syncobj */
+static void drop(int i)
+{
+    if (xg_tab[i].kind == XG_DRMNODE) {
+        uint64_t m = xg_tab[i].handle, r = 0;
+
+        xg_call(3, &m, 1, &r, 1);
+    } else if (xg_tab[i].kind != XG_DMABUF)
+        syncobj_destroy(xg_tab[i].drm_fd, xg_tab[i].handle);
+    xg_tab[i] = xg_tab[--xg_n];
+}
+
+static int new_efd(int kind, int drm_fd, uint32_t handle)
+{
+    struct xg_efd e = { .kind = kind, .drm_fd = drm_fd, .handle = handle };
+    struct stat st;
+    int p[2], i;
+
+    if (pipe(p) != 0)
+        return -1;
+    close(p[1]);
+    fcntl(p[0], F_SETFD, FD_CLOEXEC);
+    if (fstat(p[0], &st) != 0) {
+        close(p[0]);
+        return -1;
+    }
+    e.fd = p[0];
+    e.dev = st.st_dev;
+    e.ino = st.st_ino;
+    pthread_mutex_lock(&xg_lock);
+    /* stand-ins the caller has closed since: their numbers now name something else, or nothing */
+    for (i = xg_n - 1; i >= 0; i--)
+        if (!still_ours(&xg_tab[i]))
+            drop(i);
+    if (xg_n == xg_cap) {
+        int cap = xg_cap ? 2 * xg_cap : 64;
+        struct xg_efd *t = realloc(xg_tab, cap * sizeof(*t));
+
+        if (t == NULL) {
+            pthread_mutex_unlock(&xg_lock);
+            close(p[0]);
+            errno = ENOMEM;
+            return -1;
+        }
+        xg_tab = t;
+        xg_cap = cap;
+    }
+    xg_tab[xg_n++] = e;
+    pthread_mutex_unlock(&xg_lock);
+    return e.fd;
+}
+
+/* a copy of fd's entry if fd is a live stand-in */
+static int lookup(int fd, struct xg_efd *out)
+{
+    int i, found = 0;
+
+    pthread_mutex_lock(&xg_lock);
+    for (i = 0; i < xg_n; i++)
+        if (xg_tab[i].fd == fd) {
+            if (still_ours(&xg_tab[i])) {
+                *out = xg_tab[i];
+                found = 1;
+            } else
+                drop(i);
+            break;
+        }
+    pthread_mutex_unlock(&xg_lock);
+    return found;
+}
+
+/* both descriptors are the same open of the same DRM node (each devfs clone open has its own minor) */
+static int same_file(int a, int b)
+{
+    struct stat sa, sb;
+
+    return a == b || (drmXeGfxFstat(a, &sa) == 0 && drmXeGfxFstat(b, &sb) == 0 && sa.st_rdev == sb.st_rdev);
+}
+
+static int syncobj_new(int drm_fd, uint32_t *h)
+{
+    struct drm_syncobj_create c = { 0 };
+
+    if (raw_ioctl(drm_fd, DRM_IOCTL_SYNCOBJ_CREATE, &c) != 0)
+        return -1;
+    *h = c.handle;
+    return 0;
+}
+
+/* dst (binary) gets src's fence at src_point */
+static int syncobj_copy(int drm_fd, uint32_t src, uint64_t src_point, uint32_t dst, uint64_t dst_point)
+{
+    struct drm_syncobj_transfer t = {
+        .src_handle = src, .dst_handle = dst, .src_point = src_point, .dst_point = dst_point,
+    };
+
+    return raw_ioctl(drm_fd, DRM_IOCTL_SYNCOBJ_TRANSFER, &t);
+}
+
+static int fail(int err)
+{
+    errno = err;
+    return -1;
+}
+
+/* ioctls on a stand-in descriptor */
+static int efd_ioctl(const struct xg_efd *e, unsigned long request, void *arg)
+{
+    struct xg_dma_buf_sync_file *a = arg;
+    struct xg_drm_bo_fence f = { .handle = e->handle };
+    struct xg_efd s;
+    uint32_t h;
+    int fd;
+
+    if (e->kind != XG_DMABUF)
+        return fail(ENOTTY);
+    if ((a->flags & ~XG_DMA_BUF_SYNC_RW) != 0 || (a->flags & XG_DMA_BUF_SYNC_RW) == 0)
+        return fail(EINVAL);
+    f.flags = a->flags;
+    if (request == XG_DMA_BUF_IOCTL_EXPORT_SYNC_FILE) {
+        if (syncobj_new(e->drm_fd, &h) != 0)
+            return -1;
+        f.syncobj = h;
+        if (raw_ioctl(e->drm_fd, XG_DRM_IOCTL_BO_EXPORT_FENCE, &f) != 0 ||
+            (fd = new_efd(XG_SYNCFILE, e->drm_fd, h)) < 0) {
+            int err = errno;
+
+            syncobj_destroy(e->drm_fd, h);
+            return fail(err);
+        }
+        a->fd = fd;
+        return 0;
+    }
+    if (request == XG_DMA_BUF_IOCTL_IMPORT_SYNC_FILE) {
+        if (!lookup(a->fd, &s) || s.kind == XG_DMABUF || !same_file(s.drm_fd, e->drm_fd))
+            return fail(EINVAL);
+        f.syncobj = s.handle;
+        return raw_ioctl(e->drm_fd, XG_DRM_IOCTL_BO_IMPORT_FENCE, &f);
+    }
+    return fail(ENOTTY);
+}
+
+/* ioctls on the DRM node that would make the kernel create a descriptor, or take one */
+static int drm_fd_ioctl(int fd, unsigned long request, void *arg, int *handled)
+{
+    struct xg_efd s;
+    uint32_t h;
+    int nfd;
+
+    *handled = 1;
+    if (request == DRM_IOCTL_PRIME_HANDLE_TO_FD) {
+        struct drm_prime_handle *p = arg;
+
+        if ((nfd = new_efd(XG_DMABUF, fd, p->handle)) < 0)
+            return -1;
+        p->fd = nfd;
+        return 0;
+    }
+    if (request == DRM_IOCTL_PRIME_FD_TO_HANDLE) {
+        struct drm_prime_handle *p = arg;
+
+        if (!lookup(p->fd, &s))
+            return fail(EBADF);
+        if (s.kind != XG_DMABUF || !same_file(s.drm_fd, fd))
+            return fail(EINVAL);
+        p->handle = s.handle;
+        return 0;
+    }
+    if (request == DRM_IOCTL_SYNCOBJ_HANDLE_TO_FD) {
+        struct drm_syncobj_handle *a = arg;
+        int sync_file = (a->flags & DRM_SYNCOBJ_HANDLE_TO_FD_FLAGS_EXPORT_SYNC_FILE) != 0;
+
+        if (syncobj_new(fd, &h) != 0)
+            return -1;
+        if (syncobj_copy(fd, a->handle, a->point, h, 0) != 0 ||
+            (nfd = new_efd(sync_file ? XG_SYNCFILE : XG_SYNCOBJ, fd, h)) < 0) {
+            int err = errno;
+
+            syncobj_destroy(fd, h);
+            return fail(err);
+        }
+        a->fd = nfd;
+        return 0;
+    }
+    if (request == DRM_IOCTL_SYNCOBJ_FD_TO_HANDLE) {
+        struct drm_syncobj_handle *a = arg;
+
+        if (!lookup(a->fd, &s))
+            return fail(EBADF);
+        if (s.kind == XG_DMABUF || !same_file(s.drm_fd, fd))
+            return fail(EINVAL);
+        if (a->flags & DRM_SYNCOBJ_FD_TO_HANDLE_FLAGS_IMPORT_SYNC_FILE)
+            return syncobj_copy(fd, s.handle, 0, a->handle, a->point);
+        if (syncobj_new(fd, &h) != 0)
+            return -1;
+        if (syncobj_copy(fd, s.handle, 0, h, 0) != 0) {
+            int err = errno;
+
+            syncobj_destroy(fd, h);
+            return fail(err);
+        }
+        a->handle = h;
+        return 0;
+    }
+    *handled = 0;
+    return 0;
+}
+
+/* an XeGfx node answers a fence export from GEM handle 0 with ENOENT; other nodes (drm-shim, NullMoth) with ENOTTY */
+static int is_xegfx(int fd)
+{
+    struct xg_drm_bo_fence f = { .flags = 1 };
+    int saved = errno, yes;
+
+    yes = raw_ioctl(fd, XG_DRM_IOCTL_BO_EXPORT_FENCE, &f) != 0 && errno == ENOENT;
+    errno = saved;
+    return yes;
+}
+
+int drmXeGfxIoctl(int fd, unsigned long request, void *arg, int *ret)
+{
+    struct xg_efd e;
+
+    if (lookup(fd, &e) && e.kind != XG_DRMNODE) {
+        *ret = efd_ioctl(&e, request, arg);
+        return 1;
+    }
+    if ((request == DRM_IOCTL_PRIME_HANDLE_TO_FD || request == DRM_IOCTL_PRIME_FD_TO_HANDLE ||
+        request == DRM_IOCTL_SYNCOBJ_HANDLE_TO_FD || request == DRM_IOCTL_SYNCOBJ_FD_TO_HANDLE) && is_xegfx(fd)) {
+        int handled;
+
+        *ret = drm_fd_ioctl(fd, request, arg, &handled);
+        return handled;
+    }
+    return 0;
+}
+
+static void set_rdev(int fd, dev_t rdev)
+{
+    pthread_mutex_lock(&xg_lock);
+    for (int i = 0; i < xg_n; i++)
+        if (xg_tab[i].fd == fd)
+            xg_tab[i].rdev = rdev;
+    pthread_mutex_unlock(&xg_lock);
+}
+
+/* E16: libdrm's own fstat/stat/opendir/readdir/closedir/close (xf86drm.c), answered from the kernel's node list
+ * where a sandbox refuses /dev/dri, and for the stand-in of a DRM node */
+drm_public int drmXeGfxFstat(int fd, struct stat *st)
+{
+    struct xg_efd e;
+    int r = fstat(fd, st);
+
+    if (r == 0 && lookup(fd, &e) && e.kind == XG_DRMNODE) {
+        st->st_mode = S_IFCHR | 0666;
+        st->st_rdev = e.rdev;
+    }
+    return r;
+}
+
+drm_public int drmXeGfxStat(const char *path, struct stat *st)
+{
+    struct xg_node nd, l[1];
+    int r = stat(path, st), saved = errno;
+
+    if (r == 0 && !kopen_forced())
+        return 0;
+    if (r != 0 && saved != EPERM && saved != EACCES && !kopen_forced())
+        return r;
+    if (strcmp(path, "/dev/dri") == 0 && nodes(l, 1) > 0) {
+        memset(st, 0, sizeof(*st));
+        st->st_mode = S_IFDIR | 0755;
+        return 0;
+    }
+    if (node_of_path(path, &nd)) {
+        memset(st, 0, sizeof(*st));
+        st->st_mode = S_IFCHR | 0666;
+        st->st_rdev = nd.udev;
+        return 0;
+    }
+    errno = saved;
+    return r;
+}
+
+/* a /dev/dri listing made from the kernel's nodes: these handles are not DIRs, so they are told apart by address */
+struct xg_dir {
+    int next, n;
+    struct xg_node l[16];
+    struct dirent de;
+};
+static struct xg_dir *xg_dirs[8];
+
+static struct xg_dir *fake_dir(DIR *d)
+{
+    struct xg_dir *x = NULL;
+
+    pthread_mutex_lock(&xg_node_lock);
+    for (int i = 0; i < 8 && d != NULL; i++)
+        if ((void *)xg_dirs[i] == (void *)d)
+            x = xg_dirs[i];
+    pthread_mutex_unlock(&xg_node_lock);
+    return x;
+}
+
+drm_public DIR *drmXeGfxOpendir(const char *path)
+{
+    DIR *d = kopen_forced() ? NULL : opendir(path);
+    struct xg_dir *x;
+    int saved = errno, slot = -1;
+
+    if (d != NULL || strcmp(path, "/dev/dri") != 0 || (!kopen_forced() && saved != EPERM && saved != EACCES))
+        return d;
+    if ((x = calloc(1, sizeof(*x))) == NULL || (x->n = nodes(x->l, 16)) <= 0) {
+        free(x);
+        errno = saved;
+        return NULL;
+    }
+    pthread_mutex_lock(&xg_node_lock);
+    for (int i = 0; i < 8 && slot < 0; i++)
+        if (xg_dirs[i] == NULL)
+            xg_dirs[slot = i] = x;
+    pthread_mutex_unlock(&xg_node_lock);
+    if (slot < 0) {
+        free(x);
+        errno = EMFILE;
+        return NULL;
+    }
+    return (DIR *)(void *)x;
+}
+
+drm_public struct dirent *drmXeGfxReaddir(DIR *d)
+{
+    struct xg_dir *x = fake_dir(d);
+    struct xg_node *nd;
+
+    if (x == NULL)
+        return readdir(d);
+    if (x->next >= x->n)
+        return NULL;
+    nd = &x->l[x->next++];
+    memset(&x->de, 0, sizeof(x->de));
+    x->de.d_type = DT_CHR;
+    snprintf(x->de.d_name, sizeof(x->de.d_name), nd->kind ? "renderD%d" : "card%d", nd->id);
+    x->de.d_namlen = (uint16_t)strlen(x->de.d_name);
+    return &x->de;
+}
+
+drm_public int drmXeGfxClosedir(DIR *d)
+{
+    struct xg_dir *x = fake_dir(d);
+
+    if (x == NULL)
+        return closedir(d);
+    pthread_mutex_lock(&xg_node_lock);
+    for (int i = 0; i < 8; i++)
+        if (xg_dirs[i] == x)
+            xg_dirs[i] = NULL;
+    pthread_mutex_unlock(&xg_node_lock);
+    free(x);
+    return 0;
+}
+
+/* closing a DRM node's stand-in closes the kernel's instance now, not at the next stand-in made */
+drm_public int drmXeGfxClose(int fd)
+{
+    pthread_mutex_lock(&xg_lock);
+    for (int i = 0; i < xg_n; i++)
+        if (xg_tab[i].fd == fd && xg_tab[i].kind == XG_DRMNODE) {
+            drop(i);
+            break;
+        }
+    pthread_mutex_unlock(&xg_lock);
+    return close(fd);
+}
+#endif
