+// ---- E16 external panel producer ---------------------------------------------------------------
+// A userspace producer (the Reims daemon) opens this accelerator's 'XGDR' user client and uses
+// selector 5 to take the internal panel, present IOSurface frames with the plane's exact geometry
+// and pitch (mapped through the core's GGTT flip slots, PLANE_SURF armed, FRMCOUNT latched), and
+// give the panel back. While the token is held the internal producer's frames are consumed but
+// never touch the plane.
+static volatile uint32_t gXgPanelHeld = 0;
+static uint32_t gXgPanelHomeSurface = 0;
+static IOLock *gXgPanelLock = nullptr;
+static IOMemoryMap *gXgPanelPixMap = nullptr;
+static unsigned gXgPanelPixMapId = 0;
