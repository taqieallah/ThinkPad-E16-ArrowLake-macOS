+            if (gXgPanelPixMap) { gXgPanelPixMap->release(); gXgPanelPixMap = nullptr; }
+            gXgPanelPixMap = md->map(kIOMapDefaultCache);
+            gXgPanelPixMapId = gXgPanelPixMap ? req.surface_id : 0;
+        }
