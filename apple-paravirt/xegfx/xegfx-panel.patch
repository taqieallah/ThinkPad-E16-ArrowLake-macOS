+static bool nvXgPanelHeldFlag() { return __atomic_load_n(&gXgPanelHeld, __ATOMIC_ACQUIRE) != 0; }
+
+static volatile uint32_t *nvXgPanelRegs()
+{
+    if (!gXeMmio && NVAccel::gAccel && NVAccel::gAccel->fPCI)
+        gXeMmio = NVAccel::gAccel->fPCI->mapDeviceMemoryWithRegister(kIOPCIConfigBaseAddress0, kIOMapInhibitCache);
+    if (!gXeMmio || gXeMmio->getLength() < 0x80000) return nullptr;
+    return (volatile uint32_t *)gXeMmio->getVirtualAddress();
+}
+static int nvXgPanelPipe(volatile uint32_t *r, uint32_t *w, uint32_t *h, uint32_t *pitch)
+{
+    if (!r) return -1;
+    for (int p = 0; p < 4; p++) {
+        if (!(r[(0x70008 + p * 0x1000) / 4] & 0x80000000u)) continue;              // transcoder off
+        const uint32_t ctl = r[(0x70180 + p * 0x1000) / 4];
+        if (!(ctl & 0x80000000u) || (ctl & (7u << 10)) || ((ctl >> 24) & 0xf) != 8) continue;  // on, linear, 32bpp
+        const uint32_t size = r[(0x70190 + p * 0x1000) / 4];
+        const uint32_t stride = (r[(0x70188 + p * 0x1000) / 4] & 0x7ff) * 64u;
+        const uint32_t pw = (size & 0xffff) + 1, ph = ((size >> 16) & 0xffff) + 1;
+        if (!pw || !ph || !stride) continue;
+        *w = pw; *h = ph; *pitch = stride; return p;
+    }
+    return -1;
+}
