+// ---- E16 external panel producer: the selector-5 method and the token lifecycle ----------------
+void IOAccelXeGfxDRMClient::panelRelease()
+{
+    if (!fPanelToken) return;
+    fPanelToken = false;
+    // nvXeFlipHome writes the surface captured at the first flip (which, after ACQUIRE, is the home
+    // surface the plane had) and only then releases the retained frames, so the plane never scans
+    // freed pages. It also settles a live internal flip.
+    nvXeFlipHome();
+    if (gXgPanelPixMap) { gXgPanelPixMap->release(); gXgPanelPixMap = nullptr; }
+    gXgPanelPixMapId = 0;
+    gXgPanelHomeSurface = 0;
+    __atomic_store_n(&gXgPanelHeld, 0, __ATOMIC_RELEASE);
+    ALOG("panel: external producer released the panel");
+}
+
+IOReturn IOAccelXeGfxDRMClient::panelMethod(IOExternalMethodArguments *a)
+{
+    if (!a || !a->structureInput || !a->structureOutput ||
+        a->structureInputSize < sizeof(struct xg_panel_request) ||
+        a->structureOutputSize < sizeof(struct xg_panel_reply))
+        return kIOReturnBadArgument;
+    struct xg_panel_request req; bzero(&req, sizeof req);
+    memcpy(&req, a->structureInput, sizeof req);
+    if (req.struct_size != sizeof req || req.op > XG_PANEL_OP_RELEASE) return kIOReturnBadArgument;
+    struct xg_panel_reply rep; bzero(&rep, sizeof rep);
+    rep.struct_size = sizeof rep;
+
+    volatile uint32_t *r = nvXgPanelRegs();
+    uint32_t w = 0, h = 0, pitch = 0;
+    int pipe = nvXgPanelPipe(r, &w, &h, &pitch);
+
+    switch (req.op) {
+    case XG_PANEL_OP_INFO:
+        rep.status = (pipe < 0) ? XG_PANEL_ERR_PLANE : XG_PANEL_OK;
+        rep.pipe = pipe < 0 ? 0xffffffffu : (uint32_t)pipe;
+        rep.width = w; rep.height = h; rep.pitch = pitch;
+        rep.format = XG_PANEL_FORMAT_BGRA; rep.refresh_hz = 0; rep.present_count = 0;
+        break;
+    case XG_PANEL_OP_ACQUIRE: {
+        if (pipe < 0) { rep.status = XG_PANEL_ERR_PLANE; break; }
+        if (!gXgPanelLock) {
+            IOLock *l = IOLockAlloc();
+            if (l && !OSCompareAndSwapPtr(nullptr, l, (void *volatile *)&gXgPanelLock)) IOLockFree(l);
+        }
+        if (!gXgPanelLock) { rep.status = XG_PANEL_ERR_STATE; break; }
+        IOLockLock(gXgPanelLock);
+        if (fPanelToken) { IOLockUnlock(gXgPanelLock); rep.status = XG_PANEL_OK; break; }
+        if (__atomic_load_n(&gXgPanelHeld, __ATOMIC_ACQUIRE)) { IOLockUnlock(gXgPanelLock); rep.status = XG_PANEL_ERR_BUSY; break; }
+        if (gXeFlipLive != ~0u) nvXeFlipHome();               // settle the internal producer first
+        pipe = nvXgPanelPipe(r, &w, &h, &pitch);
+        if (pipe < 0) { IOLockUnlock(gXgPanelLock); rep.status = XG_PANEL_ERR_PLANE; break; }
+        if (gIopVblPipe < 0) gIopVblPipe = pipe;              // nvXeFlipNow arms this pipe
+        gXgPanelHomeSurface = r[(0x7019c + pipe * 0x1000) / 4] & ~0xfffu;
+        __atomic_store_n(&gXgPanelHeld, 1, __ATOMIC_RELEASE);
