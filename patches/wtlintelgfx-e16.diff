+/*
+ * Idle probe for the deferred display flip (K9): has everything the GPU was asked to do finished?  The
+ * accelerator's flip worker calls this through "xgFlipQuery" every millisecond before it points the plane at
+ * a frame, so a frame is only scanned out once the requests that wrote it are complete.  Thread context only,
+ * does not sleep: intel_engine_is_idle just looks at the request queues and the engine's PM state.
+ */
+int
+xg_i915_idle(void)
+{
+	struct pci_dev *pdev = NULL;
+	struct drm_i915_private *i915 = xg_i915_find(&pdev);
+	struct intel_gt *gt;
+	struct intel_engine_cs *engine;
+	int id;
+
+	if (!i915)
+		return (-ENODEV);
+	gt = to_gt(i915);
+	for (id = 0; id < I915_NUM_ENGINES; id++) {
+		engine = gt->engine[id];
+		if (engine && !intel_engine_is_idle(engine))
+			return (0);
+	}
+	return (1);
+}
