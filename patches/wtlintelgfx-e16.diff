+    if (!g_pcache || !pvkGetPipelineCacheDataX || !g_pcache_path[0]) return;
+    size_t n = 0;
+    if (pvkGetPipelineCacheDataX(g_dev, g_pcache, &n, NULL) != VK_SUCCESS || !n || n > (128u << 20)) return;
