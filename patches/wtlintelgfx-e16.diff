+// ---- E16 K9b: the flip worker's wait for the frame (ArrowWhatever K9 + our per-surface marks) -----------------------
+// With the completion marks on (nvaccel_surface_gpu_on=1) WindowServer no longer waits for its composites; the worker
+// does. The per-surface pending bit alone starves on a busy desktop: WindowServer keeps committing new work into the
+// same surface, so the bit rarely clears and every frame ran into the 100 ms bound (timeouts + glitches, 2026-11-01).
+// Here the frame is ready when its surface mark clears OR the whole GPU is idle (core "xgFlipQuery", the K9 ordering
+// point: idle means every request that wrote this frame is done), polled every 0.5 ms, at most xe_idle_ms.
+static int gXeK9 = 1, gXeIdleMs = 40;
+static SInt64 gCntXeK9Mark, gCntXeK9Idle, gCntXeK9Forced, gCntXeK9Free;
+static int gXeK9MaxUs, gXeK9NoQuery;
+SYSCTL_INT(_debug, OID_AUTO, nvaccel_xe_k9, CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_KERN, &gXeK9, 0, "E16: 1 = the flip worker waits for surface-ready OR GT idle (K9b, default); 0 = surface mark only (100 ms bound)");
+SYSCTL_INT(_debug, OID_AUTO, nvaccel_xe_idle_ms, CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_KERN, &gXeIdleMs, 0, "E16: longest K9b wait for a frame, ms (then it is shown anyway, counted in xe_k9_forced)");
+SYSCTL_QUAD(_debug, OID_AUTO, nvaccel_xe_k9_free, CTLFLAG_RD | CTLFLAG_LOCKED, &gCntXeK9Free, "E16: K9b frames that were ready at once");
+SYSCTL_QUAD(_debug, OID_AUTO, nvaccel_xe_k9_mark, CTLFLAG_RD | CTLFLAG_LOCKED, &gCntXeK9Mark, "E16: K9b frames released by their surface mark");
+SYSCTL_QUAD(_debug, OID_AUTO, nvaccel_xe_k9_idle, CTLFLAG_RD | CTLFLAG_LOCKED, &gCntXeK9Idle, "E16: K9b frames released by GT idle");
+SYSCTL_QUAD(_debug, OID_AUTO, nvaccel_xe_k9_forced, CTLFLAG_RD | CTLFLAG_LOCKED, &gCntXeK9Forced, "E16: K9b frames shown after xe_idle_ms without either");
+SYSCTL_INT(_debug, OID_AUTO, nvaccel_xe_k9_max_us, CTLFLAG_RW | CTLFLAG_LOCKED, &gXeK9MaxUs, 0, "E16: longest K9b wait, us (write 0 to reset)");
+static bool nvXeSurfPending(unsigned id)
+{
+    IOLock *l = gSurfPendLock;
+    if (!l || !id || !gSurfGpuOn) return false;
+    bool pend = false;
+    IOLockLock(l);
+    for (unsigned i = 0; i < 32; i++) if (gSurfPend[i].id == id) { pend = true; break; }
+    IOLockUnlock(l);
+    return pend;
+}
+static void nvXeWaitFrame(unsigned id)
+{
+    if (!gXeK9 || !gXeFlip || gXeK9NoQuery) { nvSurfWaitReady(id); return; }
+    if (!nvXeSurfPending(id)) { OSAddAtomic64(1, &gCntXeK9Free); return; }
+    const uint64_t t0 = mach_absolute_time();
+    const unsigned budgetUs = (unsigned)((gXeIdleMs > 0 && gXeIdleMs <= 100 ? gXeIdleMs : 40) * 1000);
+    SInt64 *why = &gCntXeK9Forced;
+    for (;;) {
+        if (!nvXeSurfPending(id)) { why = &gCntXeK9Mark; break; }
+        int idle = 0;
+        if (nvXeResidentCall("xgFlipQuery", &idle, nullptr, nullptr, nullptr) != kIOReturnSuccess || idle < 0) {
+            gXeK9NoQuery = 1; ALOG("iop: E16 K9b: core has no xgFlipQuery - surface marks only"); nvSurfWaitReady(id); return; }
+        if (idle == 1) { why = &gCntXeK9Idle; break; }
+        if (nvXeUs(t0) >= budgetUs) break;
+        IODelay(500);
+    }
+    OSAddAtomic64(1, why);
+    const int us = (int)nvXeUs(t0); if (us > gXeK9MaxUs) gXeK9MaxUs = us;
+}
+// The copy branch of performTransaction for one IOSurface, on the worker.
+bool NVDisplayPipe::xeCopyNow(IOService *fb, unsigned head, IOSurface *s)
+{
+    NVAccel *a = NVAccel::gAccel;
+    if (!a || !fb || !s) return false;
+    nvXeWaitFrame(s->getSurfaceID());   // K9b: surface mark OR GT idle, bounded
+    if (!nvAccelSurfCopyReady(s, head)) return true;   // keeps the previous picture, as the inline path does
+    if (s->getPixelFormat() != 0x42475241u) return false;
+    const unsigned long long W = s->getWidth(), H = s->getHeight(), P = s->getBytesPerRow();
+    if (!W || !H || W > 16384 || H > 16384 || P < 4 * W || (P & 3)) return false;
+    IOMemoryDescriptor *md = s->getMemoryDescriptor();
+    if (!md) return false;
+    const volatile unsigned int *src = (const volatile unsigned int *)iopMapSurface(s->getSurfaceID(), md, H * P);
+    if (!src) return false;
+    struct NVRMVramRequest q;
+    for (unsigned i = 0; i < sizeof q; i++) ((volatile unsigned char *)&q)[i] = 0;
+    q.version = NVRM_VRAM_ABI_VERSION;
+    if (a->askFramebufferForScanout(&q, fb) != kIOReturnSuccess || !q.kva || q.pitch < 4 || !q.height) return false;
+    if (W != q.width || H != q.height) return false;
+    if (gXeFlip && head == 4) {
+        if (gIopVblPipe < 0) (void)nvXeWaitVblank(a->fPCI, (unsigned)H);   // finds the panel's pipe
+        if (nvXeFlipNow(this, (unsigned)H, s, P, src)) return true;
+    }
+    if (gXeFlipLive != ~0u) nvXeFlipHome();   // copying again: the plane must scan the firmware framebuffer
+    nvAccelIopHome(fb, head);
+    const unsigned w = (unsigned)W, h = (unsigned)H, pitch = (unsigned)P;
+    const unsigned words = (((pitch < q.pitch) ? pitch : q.pitch) & ~3u) / 4, spr = pitch / 4, dpr = q.pitch / 4;
+    volatile unsigned int *d = (volatile unsigned int *)q.kva;
+    if (gIopVblSync) OSAddAtomic64(1, nvXeWaitVblank(a->fPCI, h) ? &gCntIopVblHit : &gCntIopVblMiss);
+    const uint64_t t0 = mach_absolute_time();
+    if (gIopClflush) nvXeIopClflush(src, (size_t)h * pitch);
+    if (pitch == q.pitch) memcpy((void *)d, (const void *)src, (size_t)h * pitch);
+    else for (unsigned y = 0; y < h; y++)
+        memcpy((void *)(d + (unsigned long)y * dpr), (const void *)(src + (unsigned long)y * spr), (size_t)words * 4);
+    gIopCopyUs = (int)nvXeUs(t0); if (gIopCopyUs > gIopCopyUsMax) gIopCopyUsMax = gIopCopyUs;
+    (void)w;
+    OSAddAtomic64(1, &gCntIopSrcSurf); OSAddAtomic64(1, &gCntIopOk); OSAddAtomic64(1, &gCntIopOkHead[head]);
+    return true;
+}
